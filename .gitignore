# Virtual environment
venv/
.venv/

# Python bytecode cache
__pycache__/
*.py[cod]

# Jupyter checkpoint files
.ipynb_checkpoints/

# Secrets / environment variables
.env

# OS-generated files
.DS_Store
Thumbs.db

# Raw scraped evidence — bulky, kept out of git.
